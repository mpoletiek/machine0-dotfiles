-- Hyprland config entry point (Lua format, Hyprland 0.55+).
-- Actual settings live in ~/.config/hypr/conf.d/*.lua
-- See https://wiki.hypr.land/Configuring/
--
-- Migrated from the legacy hyprlang hyprland.conf. The old .conf files are
-- kept alongside as *.conf.bak — delete hyprland.lua to fall straight back to
-- them, since Hyprland only loads the legacy config when no .lua one exists.

-- Hyprland resolves require() against this directory, but a dotted module name
-- ("conf.d.00-monitors") would be read as the path conf/d/00-monitors.lua --
-- the literal dot in "conf.d" cannot be addressed that way. Putting the
-- directory on package.path lets the modules keep their existing names.
--
-- The config root is added too so "noctalia.noctalia-colors" resolves without
-- depending on Hyprland having pre-seeded package.path for us.
local cfg = os.getenv("HOME") .. "/.config/hypr"
package.path = cfg .. "/conf.d/?.lua;" .. cfg .. "/?.lua;" .. package.path

-- Order matters: 20-programs defines the shared program/modifier names that
-- 60-binds and 70-rules reference, so it has to run before them.
require("00-monitors")
require("10-env")
require("20-programs")
require("30-autostart")
require("40-look")
require("50-input")
require("60-binds")
require("70-rules")

-- Local overrides (not tracked). Create this file if you want per-machine tweaks.
-- require("99-local")

-- Colour scheme, generated by noctalia-shell. Sourced last so it overrides the
-- border colours set in 40-look.lua.
--
-- NOTE: noctalia writes noctalia-colors.CONF from its own template; this .lua
-- is a one-time conversion of the colours that were current at migration time.
-- Changing colour scheme in noctalia will update the .conf, not this file, so
-- the borders here will go stale until noctalia is taught to emit Lua.
require("noctalia.noctalia-colors")
